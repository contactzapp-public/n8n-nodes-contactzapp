{
	"name": "n8n-nodes-contactzapp",
	"version": "0.1.0",
	"description": "n8n community node for ContactZapp: find, add and update your contacts, start a sync, and start workflows when your contacts change",
	"license": "MIT",
	"homepage": "https://github.com/contactzapp-public/n8n-nodes-contactzapp#readme",
	"keywords": [
		"n8n-community-node-package",
		"contactzapp",
		"contacts",
		"address book",
		"sync"
	],
	"author": {
		"name": "ContactZapp",
		"email": "support@contactz.app"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/contactzapp-public/n8n-nodes-contactzapp.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease",
		"contract": "npm run build && node scripts/write-contract-uses.mjs",
		"test": "npm run build && node --test test/*.test.mjs"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/ContactZappApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ContactZapp/ContactZapp.node.js",
			"dist/nodes/ContactZapp/ContactZappTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^21.1.0",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"bugs": {
		"url": "https://github.com/contactzapp-public/n8n-nodes-contactzapp/issues"
	},
	"engines": {
		"node": ">=20.15"
	}
}
